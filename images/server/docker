#!/bin/sh
# Stands in for the docker CLI. Nod only runs
#   docker exec -i [--user U] [--workdir W] <container> <cmd...>
# against its workspace and browser, so this maps that onto kubectl exec.
set -eu

[ "${1:-}" = exec ] || { echo "nod docker shim: only 'docker exec' is supported" >&2; exit 125; }
shift
user= workdir=
while [ $# -gt 0 ]; do
  case "$1" in
    -i) shift ;;
    --user) user=$2; shift 2 ;;
    --workdir) workdir=$2; shift 2 ;;
    -*) echo "nod docker shim: unsupported option $1" >&2; exit 125 ;;
    *) break ;;
  esac
done
pod=$1
shift

case "$pod" in
  nod-workspace-0)
    # Kubernetes exec cannot pick a user, so the workspace runs as root with
    # only SETUID/SETGID and drops to the requested user here.
    case "$user" in
      node) uid=1000 gid=1000 home=/home/node ;;
      [2-5][0-9][0-9][0-9][0-9]:1002) uid=${user%:*} gid=1002 home=/ ;;
      *) echo "nod docker shim: refused user '$user'" >&2; exit 125 ;;
    esac
    set -- setpriv --reuid="$uid" --regid="$gid" --clear-groups \
      env -C "${workdir:-/workspace}" HOME="$home" "$@"
    ;;
  nod-browser-0)
    [ "$user" = node ] && [ -z "$workdir" ] || { echo "nod docker shim: refused browser exec" >&2; exit 125; }
    ;;
  *) echo "nod docker shim: unknown container '$pod'" >&2; exit 125 ;;
esac

# Nod strips the environment before calling docker, so restore in-cluster config.
export KUBERNETES_SERVICE_HOST=kubernetes.default.svc KUBERNETES_SERVICE_PORT=443 HOME=/tmp
exec kubectl exec -i --quiet "$pod" -- "$@"
